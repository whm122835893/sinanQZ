# =====================================================================
# 司南ART 后端 · 生产环境 .env 模板
#
# 用法：不要直接上传这份文件。在服务器上 cp .env.example .env 后，
#       用下面的命令把三处密钥就地生成，密钥永远不落回本地仓库：
#
#   cd /www/wwwroot/sinan-backend
#   KEY=$(openssl rand -hex 32); U=$(openssl rand -hex 32); A=$(openssl rand -hex 32)
#   sed -i "s|__APP_KEY__|$KEY|; s|__JWT_USER__|$U|; s|__JWT_ADMIN__|$A|" .env
#   chmod 600 .env && chown www:www .env
#
# 注意：本项目 .env 的写法是「键 空格 = 空格 值」，ThinkPHP 能解析，
#       但 parse_ini_file 风格脚本不行；用 sed 精确替换别整段重写。
# =====================================================================

# 生产必须 false。true 会把堆栈和 SQL 直接吐给访客。
# 且 false 会触发 fail-closed 校验：APP_KEY 缺失/弱值、JWT 密钥仍是
# change-me 占位串时，相关功能直接抛异常拒绝启动 —— 这是保护不是故障。
APP_DEBUG = false

# 本轮经你确认保持 mock：任意验证码可登录、支付直接返回成功。
# 正式对外营业前必须处理，否则任何人都能登进别人账号。
SMS_MOCK = true
PAY_MOCK = true

# 实名信息 AES-256 密钥，≥32 字节随机串。
# 换密钥前必须先 php think rekey:encrypted <旧> <新> --dry-run 预览再执行，
# 否则库里已加密的存量数据全部解不开。
APP_KEY = __APP_KEY__

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = sinan_nft
# 独立业务账号，只给 DML 权限，不用 root
USERNAME = sinan_app
PASSWORD = __DB_PASSWORD__
# 本地开发是 3308（E:\mysql8-portable），服务器上是默认 3306 —— 这行必须改
HOSTPORT = 3306
CHARSET = utf8mb4

DEFAULT_LANG = zh-cn

[JWT]
# C 端 token 密钥，≥32 字节，与后台密钥必须不同
SECRET = __JWT_USER__
# 管理端 token 密钥
ADMIN_SECRET = __JWT_ADMIN__
ALGO = HS256
EXPIRE = 86400
