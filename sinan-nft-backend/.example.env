# ============================================================
# 司南珍藏 · 环境配置模板（生产安全版）
# ============================================================
# 使用：cp .example.env .env 后替换所有 change-me 占位值
#
# ⚠️ 生产部署必读：
#   1. APP_DEBUG 必须为 false（true 会向访客暴露详细错误/堆栈/SQL，弱密钥保护失效）
#   2. APP_KEY / JWT.SECRET / JWT.ADMIN_SECRET 必须替换为 ≥32 字节随机串
#      （代码层 fail-closed：APP_DEBUG=false 时保留 change-me 占位串将直接抛异常拒绝启动）
#   3. 数据库账号必须使用独立业务账号（仅授权本库 DML），禁止 root
#
# 密钥生成（三个密钥各自独立生成，禁止复用）：
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
#   或：openssl rand -hex 32
#
# ⚠️ 更换 APP_KEY 前必须先轮换存量密文，否则实名/短信/支付/链网络
#    密文将全部无法解密（数据变砖）：
#    php think rekey:encrypted <旧密钥> <新密钥> --dry-run   # 预览
#    php think rekey:encrypted <旧密钥> <新密钥>             # 执行

APP_DEBUG = false

# 应用层 AES 密钥（≥32 字节随机串）：
# 加密实名信息、短信密钥、支付渠道配置、链网络密钥
APP_KEY = change-me-openssl-rand-hex-32

DEFAULT_LANG = zh-cn

# 注：PAY_MOCK / SMS_MOCK 已废弃——支付渠道由后台「系统设置→支付渠道」(nft_payment_channels)
# 统一管理，短信由后台「系统设置→短信配置」(nft_sms_configs) 统一管理。
# 生产环境请勿设置这两个开关；如需保留请务必置 false。

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = sinan_nft
; 生产必须使用独立业务账号（仅授权本库 DML），禁止 root
USERNAME = sinan_app
PASSWORD = change-me-strong-db-password
HOSTPORT = 3306
CHARSET = utf8mb4
; 生产环境关闭 SQL 全量日志（仅排查问题时临时开启）
DEBUG = false

[JWT]
; C 端与管理端分别使用独立密钥（≥32 字节随机串，未配置/过短/占位串后端拒绝启动）
SECRET = change-me-user-jwt-openssl-rand-hex-32
ADMIN_SECRET = change-me-admin-jwt-openssl-rand-hex-32
ALGO = HS256
; C 端 token 有效期（秒，默认 86400 = 24 小时）
EXPIRE = 86400
