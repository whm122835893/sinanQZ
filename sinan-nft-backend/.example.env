APP_DEBUG = true

# 实名信息 AES-256 加密密钥（生产必须改为 ≥32 字节随机串，严禁使用仓库默认值）
APP_KEY = sinan-nft-app-key-change-me

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = sinan_nft
USERNAME = username
PASSWORD = password
HOSTPORT = 3306
CHARSET = utf8mb4

DEFAULT_LANG = zh-cn

[JWT]
# C 端用户 token 密钥（≥32 字节，否则后端拒绝签发；生产必须改为随机串）
SECRET = sinan-nft-user-secret-change-me-2026
# 管理端 token 密钥（≥32 字节，否则后端拒绝启动）
ADMIN_SECRET = sinan-nft-admin-secret-change-me
ALGO = HS256
# C 端 token 有效期（秒，默认 86400）
EXPIRE = 86400