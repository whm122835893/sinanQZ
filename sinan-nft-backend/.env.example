; ============================================================
; 司南珍藏 · 环境配置模板
; ============================================================
; 使用：cp .env.example .env 后替换所有 change-me 占位值
;
; 密钥生成（三个密钥各自独立生成，禁止复用）：
;   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
;   或：openssl rand -hex 32
;
; ⚠️ 更换 APP_KEY 前必须先轮换存量密文，否则实名/短信/支付/链网络
;    密文将全部无法解密（数据变砖）：
;    php think rekey:encrypted <旧密钥> <新密钥> --dry-run   # 预览
;    php think rekey:encrypted <旧密钥> <新密钥>             # 执行
;
; 代码层强制约束（APP_DEBUG=false 时 fail-closed）：
;   - APP_KEY 为空 / 弱密钥 / 含 change-me → 敏感数据加解密直接抛异常
;   - JWT SECRET / ADMIN_SECRET 同样必须为非占位随机串

APP_DEBUG = false

; 应用层 AES 密钥（≥32 字节随机串）：
; 加密实名信息、短信密钥、支付渠道配置、链网络密钥
APP_KEY = change-me-openssl-rand-hex-32

DEFAULT_LANG = zh-cn

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = sinan_nft
; 生产必须使用独立业务账号（仅授权本库 DML），禁止 root
USERNAME = sinan_app
PASSWORD = change-me-strong-db-password
HOSTPORT = 3306
CHARSET = utf8mb4

[JWT]
; C 端与管理端分别使用独立密钥（≥32 字节随机串）
SECRET = change-me-user-jwt-openssl-rand-hex-32
ADMIN_SECRET = change-me-admin-jwt-openssl-rand-hex-32
ALGO = HS256
; Token 有效期（秒），默认 24 小时
EXPIRE = 86400
